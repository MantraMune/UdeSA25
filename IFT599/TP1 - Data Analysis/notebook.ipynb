   "source": [
    "#### 3.5 *Évolutions du comportement*"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7f2a2fb3",
   "metadata": {},
   "source": [
    "Dans le cadre d'une étude sur les évolutions de comportements, un échantillon plus conséquent aurait permis une segmentation dans le temps pour faire des comparatifs de séquences fréquentes."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f80a950e",
   "metadata": {},
   "source": [
    "#### 3.6 *Visualisations des comportements transactionnels*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "513c4d6c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x900 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import networkx\n",
    "G = networkx.DiGraph()\n",
    "\n",
    "graph_df = (\n",
    "    motif_df\n",
    "    .loc[1:10]\n",
    "    .sort_values(['support'], ascending=[True])\n",
    "    .itertuples(index=False, name=None)\n",
    ")\n",
    "\n",
    "for support, motif in graph_df:\n",
    "    for i in range(len(motif)-1):\n",
    "        # the following has a better representation \n",
    "        # with self-loops, but they overlap \n",
    "        # G.add_edge(motif[i], motif[i+1], weight=support)\n",
    "        # thus...\n",
    "        G.add_edge(motif[i]+f\"_{i}\", motif[i+1]+f\"_{i+1}\", weight=support)\n",
    "\n",
    "pos = networkx.spring_layout(G, seed=42, k=6, iterations=20)\n",
    "\n",
    "plt.figure(figsize=(16,9))\n",
    "networkx.draw_networkx(G, pos, with_labels=True, node_size=1200, arrows=True)\n",
    "networkx.draw_networkx_edge_labels(G, pos, edge_labels=networkx.get_edge_attributes(G, 'weight'), font_size=8)\n",
    "plt.axis('off');  plt.show()"
   ]
  },
