   "source": [
    "# update imported scripts (recommandation.py)\n",
    "# stackoverflow 34758129\n",
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "\n",
    "import json\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from mlxtend.frequent_patterns import fpgrowth, apriori, association_rules\n",
    "from mlxtend.preprocessing import TransactionEncoder"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8946ead1",
   "metadata": {},
   "source": [
    "Lecture des données"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "afce9611",
   "metadata": {},
   "outputs": [],
   "source": [
    "df1 = pd.read_csv(\"cards_data.csv\")\n",
    "df2 = pd.read_csv(\"users_data.csv\")\n",
    "# Quantité importante de données de transactions, les fusions suivantes demandent trop de ressources, d'où la nécessité d'échantillonner\n",
    "df3 = pd.read_csv(\"transactions_data.csv\").loc[1600:11600] # pas \".sample(frac=0.10, random_state=42)\" pour mieux refléter les séquences réelles\n",
    "with open('train_fraud_labels.json', 'r') as df4:\n",
    "    data1 = json.load(df4)\n",
    "with open('mcc_codes.json', 'r') as df5:\n",
    "    data2 = json.load(df5)\n",
    "\n",
    "print()  # afin d'éviter de faire crash le notebook par l'affichage"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "005b1f53",
   "metadata": {},
   "source": [
    "Fusion de toutes les données"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "43748237",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['card_id', 'client_id', 'card_brand', 'card_type', 'card_number',\n",
       "       'expires', 'cvv', 'has_chip', 'num_cards_issued', 'credit_limit',\n",
       "       'acct_open_date', 'year_pin_last_changed', 'card_on_dark_web',\n",
       "       'current_age', 'retirement_age', 'birth_year', 'birth_month', 'gender',\n",
       "       'address', 'latitude', 'longitude', 'per_capita_income',\n",
       "       'yearly_income', 'total_debt', 'credit_score', 'num_credit_cards', 'id',\n",
       "       'date', 'amount', 'use_chip', 'merchant_id', 'merchant_city',\n",
       "       'merchant_state', 'zip', 'mcc', 'errors', 'description', 'Statut'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df2.rename(columns={\"id\": \"client_id\"}, inplace=True)\n",
    "\n",
    "df_fusion = pd.merge(df1,df2, on=\"client_id\", how=\"inner\")\n",
    "df_fusion.rename(columns={\"id\": \"card_id\"}, inplace=True)\n",
    "\n",
    "df_fusion1 = pd.merge(df_fusion,df3, on=[\"client_id\",\"card_id\"], how=\"inner\")\n",
    "# Transformer le dictionnaire mcc en DataFrame\n",
    "df_mcc = pd.DataFrame(list(data2.items()), columns=[\"mcc\", \"description\"])\n",
    "# Assurer que les types sont compatibles (int vs str)\n",
    "df_fusion1[\"mcc\"] = df_fusion1[\"mcc\"].astype(int)\n",
    "df_mcc[\"mcc\"] = df_mcc[\"mcc\"].astype(int)\n",
    "# Fusionner sur la colonne 'code_mcc'\n",
    "df_fusion2 = pd.merge(df_fusion1, df_mcc, on=\"mcc\", how=\"left\")\n",
    "\n",
    "# Transformer le dictionnaire train_fraud_labels en DataFrame\n",
    "# S'assurer que les types sont compatibles\n",
    "df_fraud = pd.DataFrame(list(data1[\"target\"].items()), columns=[\"id\", \"Statut\"])\n",
    "df_fusion2[\"id\"] = df_fusion1[\"id\"].astype(str)\n",
    "df_fraud[\"id\"] = df_fraud[\"id\"].astype(str)\n",
    "# Fusionner sur la colonne 'id'\n",
    "df_fusion3 = pd.merge(df_fusion2, df_fraud, on=\"id\", how=\"left\")\n",
    "df_fusion3.columns\n"
   ]
  },
