   "source": [
    "#### 3.2 *Parcours typiques avec l'algorithme PrefixSpan*\n",
    "\n",
    "Identifier les parcours clients typiques par projection récursive de préfixes séquentiels."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dcf34767",
   "metadata": {},
   "outputs": [],
   "source": [
    "from prefixspan import PrefixSpan\n",
    "\n",
    "ps = PrefixSpan(sequences)\n",
    "ps.minlen, ps.maxlen = 2, 5\n",
    "# une séquence de 1 item ne fait pas sens,\n",
    "# pour 10 000 transactions avec environ 2000 clients, \n",
    "# on a moins de 5 événements par client en moyenne\n",
    "\n",
    "\n",
    "support_min = 0.02 # support significatif\n",
    "motifs = ps.frequent(int(support_min*len(sequences)))"
   ]
  },
