      "\n",
      "Séquence simple:\n",
      " (['miscellaneous_food_stores'], 191)\n",
      "\n",
      "Deux items:\n",
      " (['miscellaneous_food_stores'], 87)\n"
     ]
    }
   ],
   "source": [
